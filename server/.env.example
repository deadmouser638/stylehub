# ==============================================================================
# ElectroHub Environment Configuration Template (Database-Free Demo)
# Copy this file to .env in server/ and set in Vercel Project Settings
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Private JWT / Session Secret (at least 32 characters, required on hosted deployments)
JWT_SECRET=replace_with_a_private_random_string_at_least_32_characters

# Optional private admin credentials for the control panel demo
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Allowed frontend origins for CORS (comma-separated, e.g. https://your-site.vercel.app)
ALLOWED_ORIGINS=
