# ==============================================================================
# StyleHub Environment Configuration Template
# Copy this file to .env in the same directory (server/.env) and fill in your values
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# JWT Secret for User & Admin Authentication (replace with a long random string)
JWT_SECRET=replace_with_a_private_random_string_at_least_32_characters

# Optional private admin bootstrap for a local demo. Never publish credentials.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Checkout is simulated. Never add live payment credentials to this demo.
